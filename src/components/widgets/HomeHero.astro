---
/**
 * HomeHero — editorial masthead for the home page ("Editorial Atlas" AD).
 *
 *  - Keeps the SplitReveal <h1> line-mask reveal + the `.gv-gradient-text` word.
 *  - `tagline` renders as an <Overline> kicker above the headline.
 *  - Reserved full-bleed WebGL container (#hero-canvas) with a token-built CSS
 *    gradient poster + scrim. Its box is locked (section min-height + inset:0)
 *    so mounting a canvas in Phase 3 causes ZERO layout shift.
 *  - Route-draw signature: a hairline SVG path «Андижан» → «Ташкент». Renders
 *    fully drawn (static) with no JS / reduced motion; the scoped script only
 *    animates stroke-dashoffset once, post-paint, under
 *    (prefers-reduced-motion: no-preference).
 *
 * Phase 3: <HeroCanvas /> mounts the WebGL "current" shader into #hero-canvas
 * (capability-gated, lazy, CLS-free — the CSS poster stays as the underlay).
 */
import Button from '~/components/ui/Button.astro';
import Overline from '~/components/ui/Overline.astro';
import SplitReveal from '~/components/ui/SplitReveal.astro';
import HeroCanvas from '~/components/common/HeroCanvas.astro';

import type { Hero } from '~/types';

type Props = Hero & { fromLabel?: string; toLabel?: string };

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  actions = await Astro.slots.render('actions'),
  id,
  fromLabel = 'Андижан',
  toLabel = 'Ташкент',
} = Astro.props;
---

<section class="hero not-prose md:-mt-[76px]" {...id ? { id } : {}}>
  {
    /* Reserved, box-locked WebGL container (inset:0 + section min-height → the
      canvas mount is CLS-free). <HeroCanvas /> renders no markup; it is the
      capability-gated client island that lazy-mounts the shader in here. */
  }
  <div id="hero-canvas" class="hero__canvas" aria-hidden="true"></div>
  <HeroCanvas />

  <div class="hero__inner">
    <div class="hero__spacer" aria-hidden="true"></div>

    <div class="hero__stage">
      {
        tagline && (
          <div class="hero__kicker">
            <Overline>{tagline}</Overline>
          </div>
        )
      }

      {title && <SplitReveal as="h1" class="hero__title" html={title} />}

      <div class="hero__route" aria-hidden="true">
        <svg
          class="hero__route-svg"
          viewBox="0 0 340 46"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="presentation"
        >
          <path
            id="hero-route-path"
            class="hero__route-path"
            d="M10 32 C 78 4, 150 6, 214 20 S 300 34, 330 16"
            pathLength="1"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
          <circle cx="10" cy="32" r="3.5" class="hero__route-dot hero__route-dot--from"></circle>
          <circle cx="330" cy="16" r="4" class="hero__route-dot hero__route-dot--to"></circle>
        </svg>
        <div class="hero__route-labels">
          <span>{fromLabel}</span>
          <span>{toLabel}</span>
        </div>
      </div>

      {subtitle && <p class="hero__subtitle" set:html={subtitle} />}

      {
        actions && Array.isArray(actions) && actions.length > 0 && (
          <div class="hero__actions">
            {actions.map((action) => (
              <Button {...(action || {})} class="hero__btn" />
            ))}
          </div>
        )
      }
      {actions && !Array.isArray(actions) && <Fragment set:html={actions} />}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    /* Locks the reserved canvas box → Phase-3 canvas mount is CLS-free. */
    min-height: 34rem;
  }
  @media (min-width: 768px) {
    .hero {
      min-height: min(88vh, 46rem);
      display: flex;
      align-items: center;
    }
  }

  /* Reserved WebGL container — token-built gradient poster (ink-azure → paper,
     a whisper of ceramic) + a scrim so text contrast is unaffected. */
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(
        128% 84% at 12% 0%,
        color-mix(in srgb, var(--aw-color-primary) 24%, transparent),
        transparent 58%
      ),
      radial-gradient(
        96% 72% at 102% 12%,
        color-mix(in srgb, var(--aw-color-ceramic) 16%, transparent),
        transparent 55%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--aw-color-primary) 9%, var(--aw-color-bg-page)),
        var(--aw-color-bg-page) 72%
      );
  }
  .hero__canvas::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--aw-color-bg-page) 24%, transparent),
      color-mix(in srgb, var(--aw-color-bg-page) 66%, transparent) 68%,
      var(--aw-color-bg-page)
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-default);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }
  .hero__spacer {
    height: 0;
  }
  @media (min-width: 768px) {
    .hero__spacer {
      height: 76px;
    }
  }

  .hero__stage {
    max-width: 52rem;
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    text-align: center;
  }

  .hero__kicker {
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-family: var(--aw-font-heading);
    font-size: var(--step-display);
    font-weight: 640;
    line-height: 1.03;
    letter-spacing: -0.02em;
    color: var(--aw-color-text-heading);
    text-wrap: balance;
  }

  /* Route-draw signature. Default = fully drawn + static (no-JS / reduced motion). */
  .hero__route {
    width: min(340px, 78%);
    margin: var(--space-6) auto 0;
    color: color-mix(in srgb, var(--aw-color-text-muted) 72%, transparent);
  }
  .hero__route-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero__route-path {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .hero__route-dot--from {
    fill: var(--aw-color-ceramic-text);
  }
  .hero__route-dot--to {
    fill: var(--aw-color-primary);
  }
  .hero__route-labels {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--aw-color-text-muted);
  }

  .hero__subtitle {
    max-width: 40rem;
    margin: var(--space-6) auto 0;
    font-size: clamp(1.05rem, 0.98rem + 0.5vw, 1.25rem);
    line-height: 1.6;
    color: var(--aw-color-text-default);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  .hero__btn {
    min-height: 44px;
  }
  @media (max-width: 519px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__route-path {
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { CustomEase } from 'gsap/CustomEase';

  gsap.registerPlugin(CustomEase);
  CustomEase.create('gv-hero-soft', '0.22, 1, 0.36, 1'); // --gv-ease-out-soft

  function drawRoute() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const path = document.getElementById('hero-route-path');
    if (!path || path.dataset.drawn) return;
    path.dataset.drawn = '1';
    gsap.set(path, { strokeDashoffset: 1 });
    gsap.to(path, { strokeDashoffset: 0, duration: 1, ease: 'gv-hero-soft', delay: 0.35 });
  }

  // Post-paint, once.
  requestAnimationFrame(() => requestAnimationFrame(drawRoute));
  // View-transition navigations bring a fresh node.
  document.addEventListener('astro:page-load', () => requestAnimationFrame(drawRoute));
</script>
