---
/**
 * DistrictsMap.astro — the flat, coloured map of Tashkent inside the
 * box-locked `#districts-map` container on /rayony.
 *
 *   Layer 0  the `.rayony-card` grid (in rayony.astro — untouched).
 *   Layer 1  this inline SVG map — ships in HTML, works with zero JS and zero
 *            animation under reduced motion. A hand-drawn schematic of the
 *            city's 12 districts (see `districts-geo.ts`): each block is an
 *            <a> to its guide, filled with its own categorical hue (NOT a rent
 *            ramp), hair-lined with the border seam, with the office at
 *            ул. Абая, 6А pinned near the Мирабад / Яккасарай seam.
 *
 * The only client behaviour is the bi-directional peer highlight shared with
 * the card grid (`peer-highlight.ts`): hovering / focusing a district tints
 * the matching card and vice-versa.
 *
 * CLS = 0: the outer box is locked by rayony.astro; `.dm` and the SVG sit
 * inside it as absolute overlays.
 */
import type { CollectionEntry } from 'astro:content';

import { getPermalink } from '~/utils/permalinks';
import { DISTRICTS_GEO, GEO_RING, GEO_VIEWBOX, OFFICE_POINT, polyLabelPoint, polyPath } from './districts-geo';

export interface Props {
  districts: CollectionEntry<'district'>[];
}

const { districts } = Astro.props as Props;

const byId = new Map(
  districts.map((e) => [
    e.id,
    {
      id: e.id,
      title: e.data.title,
      rentFrom: e.data.rentFrom,
      href: getPermalink(`/rayon/${e.id}`),
    },
  ])
);

/* On the narrowest screens only the larger blocks + the office keep a label.
   Shayxontohur is added here too: it's the longest district name (11
   characters) over a moderately-sized, kite-shaped block — the same overlap
   risk that already shrinks Мирабад / Яккасарай / Бектемир on a phone. */
const SMALL_LABEL = new Set(['mirabad', 'yakkasaray', 'bektemir', 'shayxontohur']);

const svgDistricts = DISTRICTS_GEO.flatMap((g) => {
  const d = byId.get(g.id);
  if (!d) return [];
  const [lx, ly] = polyLabelPoint(g);
  return [{ id: g.id, d, path: polyPath(g.points), lx, ly, small: SMALL_LABEL.has(g.id) }];
});

const vb = `${GEO_VIEWBOX.x} ${GEO_VIEWBOX.y} ${GEO_VIEWBOX.w} ${GEO_VIEWBOX.h}`;
---

<div class="dm" data-districts-map>
  <svg
    class="dm__svg"
    viewBox={vb}
    preserveAspectRatio="xMidYMid meet"
    role="group"
    aria-label="Схематичная карта Ташкента: 12 районов, каждый своим цветом. Нажмите район, чтобы открыть гайд."
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x={GEO_VIEWBOX.x} y={GEO_VIEWBOX.y} width={GEO_VIEWBOX.w} height={GEO_VIEWBOX.h} class="dm__bg"></rect>
    <ellipse class="dm__ring" cx={GEO_RING.cx} cy={GEO_RING.cy} rx={GEO_RING.rx} ry={GEO_RING.ry} aria-hidden="true"
    ></ellipse>

    {
      svgDistricts.map(({ id, d, path, lx, ly, small }) => (
        <a class="dm__district" href={d.href} data-district={id} aria-label={`${d.title} — аренда от ${d.rentFrom}`}>
          <title>{`${d.title} — аренда от ${d.rentFrom}`}</title>
          <path d={path} style={`fill:var(--dm-c-${id})`} />
          <text
            class:list={['dm__label', small && 'dm__label--sm']}
            x={lx}
            y={ly}
            text-anchor="middle"
            dominant-baseline="middle"
          >
            {d.title}
          </text>
        </a>
      ))
    }

    <g class="dm__office" transform={`translate(${OFFICE_POINT[0]} ${OFFICE_POINT[1]})`} aria-hidden="true">
      <circle class="dm__office-pulse" r="3"></circle>
      <path
        class="dm__office-pin"
        d="M0,-7 C-3.6,-7 -6,-4.3 -6,-1 C-6,3.2 0,9 0,9 C0,9 6,3.2 6,-1 C6,-4.3 3.6,-7 0,-7 Z"></path>
      <circle class="dm__office-pin-hole" cy="-1" r="1.7"></circle>
      <text class="dm__office-label" x="0" y="-10" text-anchor="middle">офис · ул. Абая, 6А</text>
    </g>
  </svg>

  <p class="dm__legend">Цвет — район. Нажмите район, чтобы открыть гайд.</p>
</div>

<style is:global>
  /* Categorical district palette — a muted, atlas-style 12-hue set, defined for
     light and dark with full parity. Colour encodes identity only, never rent.
     Adjacent districts are always well separated on the hue wheel. */
  :root {
    --dm-c-almazar: #dfcfb9;
    --dm-c-yunusabad: #c9dbbd;
    --dm-c-mirzo-ulugbek: #b4d5d4;
    --dm-c-mirabad: #e3c0b5;
    --dm-c-uchtepa: #bccedc;
    --dm-c-yakkasaray: #cfc8e0;
    --dm-c-chilanzar: #b9dac9;
    --dm-c-shayxontohur: #d7beda;
    --dm-c-yashnabad: #e4cdd9;
    --dm-c-yangihayot: #e1dcb7;
    --dm-c-sergeli: #b7d0d7;
    --dm-c-bektemir: #e0c7c2;
    /* Bold, near-black atlas-style border — reads as confident ink on the
       muted fills, per the classic-political-map reference. */
    --dm-border: color-mix(in srgb, var(--aw-color-text-heading) 88%, transparent);
  }
  .dark {
    --dm-c-almazar: #675742;
    --dm-c-yunusabad: #4d5d41;
    --dm-c-mirzo-ulugbek: #3e605f;
    --dm-c-mirabad: #744b3e;
    --dm-c-uchtepa: #445c6f;
    --dm-c-yakkasaray: #625483;
    --dm-c-chilanzar: #3f5f4f;
    --dm-c-shayxontohur: #66436b;
    --dm-c-yashnabad: #7e4e66;
    --dm-c-yangihayot: #6a643e;
    --dm-c-sergeli: #425f67;
    --dm-c-bektemir: #774e46;
    /* Softened to a mid grey in dark mode — a bold near-white stroke on dark
       fills read harsh; this keeps borders confident without glowing. */
    --dm-border: color-mix(in srgb, var(--aw-color-text-heading) 55%, var(--aw-color-bg-page));
  }
</style>

<style>
  .dm {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
  }

  .dm__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .dm__bg {
    fill: transparent;
  }

  /* Implied ring road under the districts. */
  .dm__ring {
    fill: none;
    stroke: var(--aw-color-border);
    stroke-width: 0.9;
    stroke-dasharray: 2.4 3.2;
    opacity: 0.75;
  }

  .dm__district {
    cursor: pointer;
    outline: none;
  }
  .dm__district path {
    stroke: var(--dm-border);
    stroke-width: 1.2;
    stroke-linejoin: round;
    transition:
      fill 170ms var(--gv-ease-out-quart),
      stroke 170ms var(--gv-ease-out-quart),
      stroke-width 170ms var(--gv-ease-out-quart);
  }
  .dm__label {
    fill: var(--aw-color-text-heading);
    font-family: var(--aw-font-sans);
    font-size: 5.2px;
    font-weight: 700;
    letter-spacing: 0.01em;
    paint-order: stroke;
    stroke: color-mix(in srgb, var(--aw-color-bg-page) 80%, transparent);
    stroke-width: 1.9;
    stroke-linejoin: round;
    pointer-events: none;
    transition: fill 170ms var(--gv-ease-out-quart);
  }
  .dm__district:hover path,
  .dm__district:focus-visible path,
  .dm__district.is-peer-hot path {
    fill: color-mix(in srgb, var(--aw-color-primary) 26%, var(--aw-color-bg-page));
    stroke: var(--aw-color-primary);
    stroke-width: 2;
  }
  .dm__district:focus-visible path {
    outline: none;
  }
  .dm__district:hover .dm__label,
  .dm__district:focus-visible .dm__label,
  .dm__district.is-peer-hot .dm__label {
    fill: var(--aw-color-primary);
  }

  /* Office marker — pin + reduced-motion-gated pulse. */
  .dm__office-pin {
    fill: var(--aw-color-primary);
    stroke: color-mix(in srgb, var(--aw-color-bg-page) 70%, transparent);
    stroke-width: 0.6;
  }
  .dm__office-pin-hole {
    fill: var(--aw-color-bg-page);
  }
  .dm__office-pulse {
    fill: none;
    stroke: var(--aw-color-primary);
    stroke-width: 0.7;
    opacity: 0.5;
    transform-box: fill-box;
    transform-origin: center;
  }
  .dm__office-label {
    fill: var(--aw-color-text-muted);
    font-family: var(--aw-font-sans);
    font-size: 3.4px;
    font-weight: 650;
    letter-spacing: 0.02em;
    paint-order: stroke;
    stroke: color-mix(in srgb, var(--aw-color-bg-page) 84%, transparent);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dm__office-pulse {
      animation: dm-pulse 3.4s var(--gv-ease-out-quart) infinite;
    }
  }
  @keyframes dm-pulse {
    0% {
      transform: scale(0.5);
      opacity: 0.55;
    }
    80% {
      opacity: 0;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dm__district path,
    .dm__label {
      transition: none;
    }
  }

  .dm__legend {
    position: absolute;
    left: clamp(10px, 2.4vw, 20px);
    bottom: clamp(10px, 2.4vw, 18px);
    right: clamp(10px, 2.4vw, 20px);
    margin: 0;
    width: max-content;
    max-width: calc(100% - clamp(20px, 4.8vw, 40px));
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.35;
    color: var(--aw-color-text-muted);
    background: color-mix(in srgb, var(--aw-color-bg-page) 82%, transparent);
    border: 1px solid var(--aw-color-border);
    border-radius: var(--gv-radius-pill);
    padding: 0.35rem 0.75rem;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    pointer-events: none;
  }

  /* Narrow screens: drop the smallest blocks' labels so nothing overlaps. */
  @media (max-width: 480px) {
    .dm__label--sm {
      display: none;
    }
    .dm__label {
      font-size: 5.7px;
    }
  }
</style>

<script>
  /**
   * Districts-map client entry: just (re)wires the Layer-1 peer bridge
   * (SVG ⇄ card highlight). No canvas, no lazy imports, no capability gate.
   */
  import { initPeerBridge } from './peer-highlight';

  declare global {
    interface Window {
      __gvMapBound?: boolean;
    }
  }

  function setup(): void {
    initPeerBridge();
  }

  if (!window.__gvMapBound) {
    window.__gvMapBound = true;
    document.addEventListener('astro:page-load', setup);
  }

  setup();
</script>
