---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { hasUzTranslation } from '~/navigation';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const currentLocale = (Astro.currentLocale === 'uz' ? 'uz' : 'ru') as 'ru' | 'uz';

// Тот же путь без языкового префикса — чтобы построить ссылку на его пару на другом языке.
const withoutLocale = Astro.url.pathname.replace(/^\/uz(\/|$)/, '/');

// Русская версия есть всегда (это основной язык сайта). Узбекская — пока только
// для переведённых разделов; для остальных ведём на узбекскую главную, а не на
// несуществующую /uz/... страницу (иначе — 404).
const ruHref = getRelativeLocaleUrl('ru', withoutLocale);
const uzTranslated = hasUzTranslation(withoutLocale);
const uzHref = getRelativeLocaleUrl('uz', uzTranslated ? withoutLocale : '/');
---

<div
  class:list={['inline-flex items-center gap-0.5 text-sm font-semibold', className]}
  aria-label="Выбор языка / Til tanlash"
>
  <a
    href={ruHref}
    class:list={[
      'px-2 py-1 rounded-[var(--gv-radius-sm)] transition-colors',
      currentLocale === 'ru' ? 'text-primary' : 'text-muted hover:text-primary',
    ]}
    aria-current={currentLocale === 'ru' ? 'page' : undefined}
  >
    RU
  </a>
  <span class="text-muted" aria-hidden="true">/</span>
  <a
    href={uzHref}
    class:list={[
      'px-2 py-1 rounded-[var(--gv-radius-sm)] transition-colors',
      currentLocale === 'uz' ? 'text-primary' : 'text-muted hover:text-primary',
    ]}
    aria-current={currentLocale === 'uz' ? 'page' : undefined}
    title={!uzTranslated && currentLocale !== 'uz'
      ? 'Этот раздел пока не переведён — откроется узбекская главная'
      : undefined}
  >
    UZ
  </a>
</div>
