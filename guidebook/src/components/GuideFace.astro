---
// The guide: a calm round face in the bank's dark green with mint eyes. Its final form is the owner's choice.
---

<svg class="guide-face" viewBox="0 0 48 48" aria-hidden="true">
  <circle class="gf-body" cx="24" cy="24" r="23" fill="var(--night)"></circle>
  <circle class="gf-heart" cx="24" cy="24" r="23" fill="none" stroke="var(--mint)" stroke-width="2" pathLength="1"></circle>
  <g class="look">
    <g class="eyes">
      <rect x="15" y="18" width="5" height="9" rx="2.5" fill="var(--mint)"></rect>
      <rect x="28" y="18" width="5" height="9" rx="2.5" fill="var(--mint)"></rect>
    </g>
  </g>
  <path d="M18 32c3.2 2.4 8.8 2.4 12 0" fill="none" stroke="var(--mint)" stroke-width="2.2" stroke-linecap="round"></path>
</svg>
