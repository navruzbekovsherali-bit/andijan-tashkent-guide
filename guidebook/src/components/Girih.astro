---
/**
 * Star-and-cross girih, shown the way a tile-maker builds it.
 * "rosette": one whole star at the centre, construction circles and strapwork around it,
 *   tiles set outward from the centre (mastheads).
 * "band": one glazed row that sets itself as it scrolls into view (edges and dividers).
 * Motion lives in global.css (.girih) and lib/client.ts (scroll progress for bands).
 */
import { tiling } from '../lib/girih';

interface Props {
  variant?: 'rosette' | 'band';
  class?: string;
}
const { variant = 'rosette', class: cls = '' } = Astro.props;

const rosette = variant === 'rosette';
const W = rosette ? 400 : 480;
const H = rosette ? 400 : 72;
const s = rosette ? 104 : 48;
const cx = W / 2;
const cy = H / 2;
// Put a star exactly on the centre of the box.
const ox = rosette ? cx - Math.ceil(cx / s) * s : 0;
const oy = rosette ? cy - Math.ceil(cy / s) * s : 36;
const tiles = tiling(W, H, s, ox, oy);
const reach = rosette ? 150 : Infinity; // glazed tiles stay inside this radius
const lines = rosette ? 215 : 0; // strapwork reaches a little further, then stops

const placed = tiles
  .map((t, i) => {
    const dist = Math.hypot(t.x - cx, t.y - cy);
    let fill: string | null = null;
    if (!rosette) fill = t.kind === 'star' ? 'var(--band-star)' : 'var(--band-cross)';
    else if (dist < reach) {
      if (t.kind === 'cross') fill = 'var(--tile-cross)';
      else fill = dist < 1 ? 'var(--tile-heart)' : i % 3 === 0 ? 'var(--tile-alt)' : 'var(--tile-star)';
    }
    const delay = rosette ? dist / 260 : t.x / W;
    return { ...t, dist, fill, delay: delay.toFixed(2) };
  })
  .filter((t) => !rosette || t.dist < lines);

// Construction: the lattice inside the compass, one big circle, and the eight rays of the star.
const rays = Array.from({ length: 8 }, (_, k) => {
  const a = (k * Math.PI) / 4;
  return `M${cx} ${cy}L${(cx + 190 * Math.cos(a)).toFixed(1)} ${(cy + 190 * Math.sin(a)).toFixed(1)}`;
}).join('');
---

<svg class:list={['girih', `girih-${variant}`, cls]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio={rosette ? 'xMidYMid meet' : 'xMidYMid slice'} aria-hidden="true">
  {
    rosette && (
      <g class="g-cons">
        <circle class="g-compass g-outer" cx={cx} cy={cy} r="190" pathLength="1" style="--d:0" />
        <path class="g-grid" d={rays} pathLength="1" />
        {placed
          .filter((t) => t.kind === 'star')
          .map((t) => (
            <circle class="g-compass" cx={t.x} cy={t.y} r={s / 2} pathLength="1" style={`--d:${t.delay}`} />
          ))}
      </g>
    )
  }
  <g class="g-tiles">{placed.filter((t) => t.fill).map((t) => <path class={`g-tile g-${t.kind}`} d={t.path} fill={t.fill} style={`--d:${t.delay}`} />)}</g>
  {
    !rosette && (
      <g class="g-lines g-band-lines">
        {placed.map((t) => (
          <path d={t.path} pathLength="1" style={`--d:${t.delay}`} />
        ))}
      </g>
    )
  }
  {
    rosette && (
      <g class="g-lines">
        {placed.map((t) => (
          <path d={t.path} pathLength="1" style={`--d:${t.delay}`} />
        ))}
      </g>
    )
  }
</svg>
