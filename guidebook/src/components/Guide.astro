---
/**
 * The on-screen guide: a lozenge woven from threads, like the ikat motif.
 * Its final form (mascot, person or icon) is still the owner's choice; this one is easy to swap.
 */
import GuideFace from './GuideFace.astro';

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<aside class="guide reveal" aria-label={name}>
  <div class="guide-avatar" aria-hidden="true"><GuideFace /></div>
  <div class="guide-bubble">
    <span class="who">{name}</span>
    <slot />
  </div>
</aside>
