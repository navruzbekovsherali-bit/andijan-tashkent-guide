---
/**
 * The on-screen guide. Its form (mascot, person or icon) is still the owner's choice,
 * so the figure here is a neutral drawn helper that is easy to replace.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<aside class="guide reveal" aria-label={name}>
  <div class="guide-avatar" aria-hidden="true">
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="20" cy="15" r="6.5"></circle>
      <path d="M9 33c1.5-6 6-9 11-9s9.5 3 11 9"></path>
      <g class="look"><path class="eyes" d="M17.5 15.5h.01M22.5 15.5h.01"></path></g>
      <path d="M17.8 18.4c1.3 1 3.1 1 4.4 0"></path>
    </svg>
  </div>
  <div class="guide-bubble">
    <span class="who">{name}</span>
    <slot />
  </div>
</aside>
