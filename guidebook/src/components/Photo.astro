---
/** A licensed photograph with its credit (data in src/data/photos.json, files in public/photos/). */
interface Props {
  id: string;
  class?: string;
  /** Sizes hint for the browser: how wide the photo shows. */
  sizes?: string;
  eager?: boolean;
  credit?: boolean;
  /** YouTube id: the photo becomes the poster and the film plays in place on tap. */
  video?: string;
  /** Accessible label for the play button. */
  videoLabel?: string;
}
const { id, class: cls = '', sizes = '(min-width: 900px) 50vw, 100vw', eager = false, credit = true, video, videoLabel = 'Смотреть видео' } = Astro.props;
const all = import.meta.glob<Record<string, any>>('../data/photos.json', { eager: true, import: 'default' });
const photos = Object.values(all)[0] ?? {};
const p = photos[id];
---

{
  p && (
    <figure class:list={['photo', cls]}>
      <div class="photo-frame" data-video={video}>
        <img
          src={`/photos/${id}-1600.webp`}
          srcset={`/photos/${id}-800.webp 800w, /photos/${id}-1600.webp 1600w`}
          sizes={sizes}
          width={p.width}
          height={p.height}
          alt={p.alt}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
        />
        {video && (
          <button type="button" class="play" data-play={video} aria-label={`${videoLabel}: ${p.caption}`}>
            <span class="play-disc" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13a.6.6 0 0 0 .9.5l10.4-6.5a.6.6 0 0 0 0-1L8.9 5a.6.6 0 0 0-.9.5Z" fill="currentColor" /></svg>
            </span>
            <span class="play-label">{videoLabel}</span>
          </button>
        )}
      </div>
      {credit && (
        <figcaption>
          <span>{p.caption}</span>
          <a href={p.source} rel="noopener" target="_blank">
            {p.author} · {p.license}
          </a>
        </figcaption>
      )}
    </figure>
  )
}
