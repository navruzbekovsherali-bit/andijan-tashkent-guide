---
// Neutral guidebook mark (not the bank logo — logo rights are still open): one girih star.
import { star, cross, d } from '../lib/girih';
---

<svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
  <path d={d(star(16, 16, 31))} fill="var(--mark-star, currentColor)"></path>
  <path d={d(cross(16, 16, 14))} fill="var(--mark-heart, var(--g-saffron))"></path>
</svg>
