---
// Hamkorbank mark, traced from the official logo the owner sent (27.10.2026, 1920px source):
// a ring (centre 965,965; radii 685/548) fused with one slanted "H"; the ring is cut by two
// bands parallel to the stems. Replace with the bank's SVG file when it arrives.
const h = '1215,476 1440,466 1125,1307 902,1307 1007,1023 880,1023 720,1480 495,1465 812,622 1033,622 928,908 1052,908';
const gapRight = '1502,300 1631,300 1403,900 1277,900';
const gapLeft = '651,1050 522,1050 315.5,1600 444.6,1600';
// The mark appears several times per page: each copy needs its own mask id.
const id = `hb-gaps-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="brand-mark" viewBox="270 270 1390 1390" aria-hidden="true">
  <defs>
    <mask id={id} maskUnits="userSpaceOnUse" x="270" y="270" width="1390" height="1390">
      <rect x="270" y="270" width="1390" height="1390" fill="#fff"></rect>
      <polygon points={gapRight} fill="#000"></polygon>
      <polygon points={gapLeft} fill="#000"></polygon>
    </mask>
  </defs>
  <circle class="bm-ring" cx="965" cy="965" r="616.5" pathLength="1" fill="none" stroke="var(--mark, #1aa752)" stroke-width="137" mask={`url(#${id})`}></circle>
  <polygon class="bm-h" points={h} fill="var(--mark, #1aa752)"></polygon>
</svg>
