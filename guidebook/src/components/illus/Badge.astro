<svg class="illus illus-badge" viewBox="0 0 320 220" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <!-- door reader on the wall -->
  <g class="bd-reader">
    <rect class="b-w" x="56" y="84" width="34" height="54" rx="7" />
    <rect class="b-s" x="63" y="92" width="20" height="26" rx="4" />
    <path d="M67 101h12M67 109h8" />
    <circle class="b-n b-nos" cx="73" cy="128" r="3" />
  </g>
  <circle class="bd-led b-m b-nos" cx="73" cy="128" r="3" />
  <path class="b-d bd-wall" pathLength="1" d="M73 84V40" />

  <!-- lanyard -->
  <path class="b-d bd-strap bd-sl" pathLength="1" d="M128 8c6 28 19 46 28 60" />
  <path class="b-d bd-strap bd-sr" pathLength="1" d="M192 8c-6 28-19 46-28 60" />

  <!-- badge: swings in from the clip and settles -->
  <g class="bd-swing">
    <g class="bd-sway">
      <rect class="b-w bd-clip" x="152" y="64" width="16" height="14" rx="4" />
      <path d="M160 78v10" />
      <rect class="b-w" x="118" y="84" width="84" height="106" rx="10" />
      <rect class="b-s" x="149" y="91" width="22" height="6" rx="3" />
      <g class="bd-photo">
        <circle class="b-s" cx="160" cy="126" r="17" />
        <clipPath id="illus-badge-face"><circle cx="160" cy="126" r="17" /></clipPath>
        <g clip-path="url(#illus-badge-face)">
          <circle class="b-w" cx="160" cy="121" r="6" />
          <path class="b-w" d="M147 146a13 13 0 0 1 26 0" />
        </g>
      </g>
      <path class="b-d bd-l1" pathLength="1" d="M140 158h40" />
      <path class="b-d bd-l2" pathLength="1" d="M148 170h24" />
      <g transform="translate(134 101)">
        <g class="bd-mark">
          <circle class="b-m b-nos" r="8" />
          <path class="b-k bd-h" d="M-2.5 -4l-1.6 8M4 -4l-1.6 8M-3 0h6" />
        </g>
      </g>
    </g>
  </g>

  <!-- coffee on the desk -->
  <path class="b-d bd-desk" pathLength="1" d="M222 190h70" />
  <g class="bd-cup">
    <path class="b-w" d="M269 158h5a8 8 0 0 1 0 16h-6" />
    <path class="b-w" d="M236 150h36l-4 34a6 6 0 0 1-6 6h-16a6 6 0 0 1-6-6Z" />
    <path class="b-s" d="M237.6 162h32.8l-1.4 12h-30Z" />
  </g>
  <g class="bd-steam">
    <path class="b-d bd-st1" pathLength="1" d="M248 140c-4-5 4-9 0-15" />
    <path class="b-d bd-st2" pathLength="1" d="M260 140c-4-5 4-9 0-15" />
  </g>
</svg>
