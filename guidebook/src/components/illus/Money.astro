    <rect class="mn-coin" style="--k:3" x="192" y="177" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:4" x="192" y="168" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:5" x="192" y="159" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:6" x="192" y="150" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:7" x="192" y="141" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:8" x="246" y="177" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:9" x="246" y="168" width="44" height="9" rx="4.5" />
    <rect class="mn-coin" style="--k:10" x="246" y="159" width="44" height="9" rx="4.5" />
