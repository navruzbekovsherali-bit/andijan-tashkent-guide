  <!-- the trend, drawn last -->
  <path class="mn-trend" pathLength="1" d="M132 152 160 136 214 112 268 92" />
  <g class="mn-dots">
    <circle class="fl" cx="160" cy="136" r="3.5" />
    <circle class="fl" cx="214" cy="112" r="3.5" />
    <circle class="mn-pulse" cx="268" cy="92" r="6" />
