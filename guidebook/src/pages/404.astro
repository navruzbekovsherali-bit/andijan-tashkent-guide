---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Illus from '../components/Illus.astro';
---

<Base lang="ru" title="Страница не найдена" path="/" current="page" back="/">
  <header class="page-head">
    <div class="wrap head-grid">
      <div>
        <h1>Такой страницы нет</h1>
        <p class="lead">Возможно, ссылка устарела или в ней опечатка. Найдите нужное через поиск или начните с главной.</p>
        <div class="meta-row">
          <a class="pill pill-dark" href="/">На главную<span class="pill-arrow"><Icon name="arrow" size={16} /></span></a>
          <button class="pill pill-light" type="button" data-sheet="search">Поиск<span class="pill-arrow"><Icon name="search" size={16} /></span></button>
        </div>
      </div>
      <Illus name="map" />
    </div>
  </header>
</Base>
