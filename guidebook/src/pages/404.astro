---
import Base from '../layouts/Base.astro';
import Guide from '../components/Guide.astro';
import Icon from '../components/Icon.astro';
---

<Base lang="ru" title="Страница не найдена" path="/" current="page">
  <header class="hub-head">
    <div class="wrap">
      <h1>Такой страницы нет</h1>
      <p>Возможно, ссылка устарела или в ней опечатка.</p>
      <Guide name="Гид">
        <p>Попробуйте поиск — он ищет по всем страницам и частым вопросам. Или начните с главной.</p>
      </Guide>
      <p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:var(--space-5)">
        <a class="btn" href="/">На главную <Icon name="arrow" size={18} /></a>
        <button class="btn ghost" type="button" data-sheet="search"><Icon name="search" size={18} /> Поиск</button>
      </p>
    </div>
  </header>
</Base>
