---
import Base from '../../../layouts/Base.astro';
import Guide from '../../../components/Guide.astro';
import Illus from '../../../components/Illus.astro';
import Icon from '../../../components/Icon.astro';
import { LANGS, DEFAULT_LANG, t, url, type Lang } from '../../../lib/i18n';
import { EXPAT_PATH, PATH_TX } from '../../../lib/path';
import { getPages, forAudience, groupBySection, SECTIONS, illusOf, HUB_ORDER, type Audience } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    (['local', 'expat'] as const).map((aud) => ({
      params: { lang: lang === DEFAULT_LANG ? undefined : lang, aud },
      props: { lang, aud },
    })),
  );
}

const { lang, aud } = Astro.props as { lang: Lang; aud: Audience };
const tr = t(lang);
const groups = groupBySection(forAudience(await getPages(lang), aud)).sort(
  (a, b) => HUB_ORDER[aud].indexOf(a.id) - HUB_ORDER[aud].indexOf(b.id),
);
const title = aud === 'local' ? tr('local') : tr('expat');
const lead = aud === 'local' ? tr('localLead') : tr('expatLead');
const hello: Record<Audience, Record<Lang, string>> = {
  local: {
    ru: 'Начните с «Первого дня и первой недели» — там весь план. Остальное открывайте, когда понадобится.',
    en: 'Start with “First day and first week” — the whole plan is there. Open the rest when you need it.',
    uz: '«Birinchi kun va birinchi hafta»dan boshlang — butun reja oʻsha yerda.',
  },
  expat: {
    ru: 'Идите сверху вниз: сначала сборы и первые 72 часа после прилёта, потом работа и жизнь здесь.',
    en: 'Go from top to bottom: packing and the first 72 hours first, then work and life here.',
    uz: 'Yuqoridan pastga yuring: avval yigʻilish va dastlabki 72 soat.',
  },
};
const P = PATH_TX[lang];
const pathTotal = EXPAT_PATH.reduce((a, s) => a + s.steps.length, 0);
// Steps are numbered through the whole route: the order is the advice.
let n = 0;
const numbered = groups.map((g) => ({ ...g, steps: g.pages.map((p) => ({ p, n: ++n })) }));
---

<Base lang={lang} title={title} description={lead} path={`/${aud}/`} audience={aud} current={aud} back={url(lang, '/')}>
  <header class="page-head">
    <div class="wrap">
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <Guide name={tr('guideName')}>
        <p>{hello[aud][lang]}</p>
      </Guide>
    </div>
  </header>

  {
    aud === 'expat' && (
      <section class="path" data-path data-all={P.all} aria-labelledby="path-h">
        <div class="wrap">
          <div class="path-top">
            <div>
              <h2 class="h2" id="path-h">{P.title}</h2>
              <p class="path-lead">{P.lead}</p>
            </div>
            <p class="path-count" aria-live="polite">
              <b data-path-done>0</b> {P.of} {pathTotal} <span>{P.done}</span>
              <span class="path-meter"><i data-path-bar /></span>
            </p>
          </div>
          <ol class="path-stages">
            {EXPAT_PATH.map((st, i) => (
              <li class="path-stage" data-stage={st.id}>
                <span class="path-dot" aria-hidden="true">
                  <b>{i + 1}</b>
                  <Icon name="check" size={18} />
                </span>
                <h3 class="path-head">
                  <button type="button" class="path-open" aria-expanded="true" aria-controls={`path-${st.id}`}>
                    <span class="path-name">{st.title[lang]}</span>
                    <span class="path-when">{st.when[lang]}</span>
                    <span class="path-n" data-path-n />
                    <Icon name="chevron" size={18} />
                  </button>
                </h3>
                <ul class="path-steps" id={`path-${st.id}`}>
                  {st.steps.map((step) => (
                    <li>
                      <button type="button" class="path-tick" data-step={step.id} aria-pressed="false" aria-label={`${P.mark}: ${step.title[lang]}`}>
                        <Icon name="check" size={16} />
                      </button>
                      <a href={url(lang, `/guide/${step.slug}/`)}>
                        <strong>{step.title[lang]}</strong>
                        <span>{step.hint[lang]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
          <p class="path-all" hidden>{P.all}</p>
        </div>
      </section>
    )
  }

  <div class="wrap">
    {
      numbered.map((g, gi) => (
        <details class="chapter" id={g.id} open={gi === 0}>
          <summary class="chapter-head">
            <Illus name={illusOf(g.id)} lang={lang} />
            <h2>{SECTIONS[g.id].title[lang]}</h2>
            <span class="chapter-n">{g.steps.length}</span>
            <Icon name="chevron" size={20} />
          </summary>
          <ol class="steps">
            {g.steps.map(({ p }) => (
              <li>
                <a href={url(lang, `/guide/${p.slug}/`)}>
                  <strong>{p.entry.data.title}</strong>
                  <span class="step-lead">{p.entry.data.description}</span>
                  <span class="round-arrow"><Icon name="arrow" size={16} /></span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      ))
    }
  </div>
</Base>
