---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Guide from '../../components/Guide.astro';
import Girih from '../../components/Girih.astro';
import { langPaths } from '../../lib/paths';
import { t, url, type Lang } from '../../lib/i18n';
import { getPages, glazeOf } from '../../lib/content';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const pages = await getPages(lang);
const bySlug = new Map(pages.map((p) => [p.slug, p]));

const popularSlugs = ['arrival-72h', 'first-day-week', 'work-time', 'salary-expat', 'relocation-budget', 'emergency'];
const popular = popularSlugs.map((s) => bySlug.get(s)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const faqPreview = pages.flatMap((p) => p.entry.data.faq.slice(0, 1).map((f) => ({ ...f, slug: p.slug }))).slice(0, 5);
---

<Base lang={lang} title={tr('siteName')} description={tr('heroLead')} path="/" current="home" field="night">
  <section class="mast mast-home" data-glaze="night">
    <Girih variant="rosette" class="mast-art" />
    <div class="wrap mast-inner">
      <h1 class="display">{tr('heroTitle')}</h1>
      <p class="mast-lead">{tr('heroLead')}</p>
      <div class="doors">
        <a class="door" href={url(lang, '/local/')} data-choose="local" data-glaze="emerald">
          <span class="door-title">{tr('local')}</span>
          <span class="door-lead">{tr('localLead')}</span>
          <Icon name="arrow" />
        </a>
        <a class="door" href={url(lang, '/expat/')} data-choose="expat" data-glaze="mint">
          <span class="door-title">{tr('expat')}</span>
          <span class="door-lead">{tr('expatLead')}</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <p class="phone-lead">{tr('heroLead')}</p>
    <Guide name={tr('guideName')}>
      <p>{tr('guideHello')}</p>
    </Guide>

    <p class="statement" data-words>{tr('manifest')}</p>

    <h2 class="block-title">{tr('popular')}</h2>
    <ul class="tiles">
      {
        popular.map((p) => (
          <li data-glaze={glazeOf(p.entry.data.section)}>
            <a href={url(lang, `/guide/${p.slug}/`)}>
              <strong>{p.entry.data.title}</strong>
              <span class="tile-lead">{p.entry.data.description}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="home-faq" data-glaze="night">
    <Girih variant="band" class="band-edge" />
    <div class="wrap">
      <h2 class="block-title">{tr('faq')}</h2>
      <div class="faq-list">
        {
          faqPreview.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <Icon name="chevron" />
              </summary>
              <div class="faq-a">
                <p>{f.a}</p>
                <a class="faq-src" href={url(lang, `/guide/${f.slug}/`)} data-glaze={glazeOf(bySlug.get(f.slug)!.entry.data.section)}>
                  {bySlug.get(f.slug)?.entry.data.title} <Icon name="arrow" size={16} />
                </a>
              </div>
            </details>
          ))
        }
      </div>
      <p class="after-faq">
        <a class="btn" href={url(lang, '/faq/')} data-glaze="mint">{tr('faq')} <Icon name="arrow" size={18} /></a>
      </p>
    </div>
  </section>
</Base>
