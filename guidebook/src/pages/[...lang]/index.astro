---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import BrandMark from '../../components/BrandMark.astro';
import Illus from '../../components/Illus.astro';
import Photo from '../../components/Photo.astro';
import { langPaths } from '../../lib/paths';
import { articles, t, url, type Lang } from '../../lib/i18n';
import { getPages, groupBySection, SECTIONS, illusOf, CITY_CARDS, PAGE_VIDEO } from '../../lib/content';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const pages = await getPages(lang);
const bySlug = new Map(pages.map((p) => [p.slug, p]));
const groups = groupBySection(pages);

const popularSlugs = ['arrival-72h', 'first-day-week', 'work-time', 'salary-expat', 'bank-card', 'emergency'];
const popular = popularSlugs.map((s) => bySlug.get(s)).filter((p): p is NonNullable<typeof p> => Boolean(p));
// The cities strip appears once the licensed photos are in place.
const hasPhotos = Object.keys(import.meta.glob('../../data/photos.json')).length > 0;
const faqPreview = pages.flatMap((p) => p.entry.data.faq.slice(0, 1).map((f) => ({ ...f, slug: p.slug }))).slice(0, 6);
---

<Base lang={lang} title={tr('siteName')} description={tr('heroLead')} path="/" current="home" dark>
  <section class="hero on-dark">
    <div class="wrap hero-in">
      <div class="hero-mark"><BrandMark /></div>
      <p class="hero-name">Hamkor Bank</p>
      <h1 class="hero-title">{tr('heroTitle')}</h1>
      <p class="hero-lead">{tr('heroLead')}</p>
      <div class="hero-actions">
        <a class="pill pill-mint" href={url(lang, '/local/')} data-choose="local">
          {tr('local')}
          <span class="pill-arrow"><Icon name="arrow" size={18} /></span>
        </a>
        <a class="pill pill-ghost" href={url(lang, '/expat/')} data-choose="expat">
          {tr('expat')}
          <span class="pill-arrow"><Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="quick">
    <div class="wrap">
      <button class="quick-search" type="button" data-sheet="search">
        <Icon name="search" />
        <span>{tr('quickSearch')}</span>
      </button>
      <ul class="quick-chips">
        <li><a class="qchip sos-chip" href={url(lang, '/guide/emergency/')}><span class="sos-dot" aria-hidden="true" />{tr('emergency')}</a></li>
        <li><a class="qchip" href={url(lang, '/guide/first-day-week/')}>{tr('qFirstDay')}</a></li>
        <li><button class="qchip" type="button" data-sheet="search" data-q={tr('qSalaryQ')}>{tr('qSalary')}</button></li>
        <li><button class="qchip" type="button" data-sheet="search" data-q={tr('qRegQ')}>{tr('qReg')}</button></li>
        <li><button class="qchip" type="button" data-sheet="search" data-q="IMEI">IMEI</button></li>
      </ul>
    </div>
  </section>

  <section class="block" id="topics">
    <div class="wrap">
      <div class="block-head">
        <h2 class="h2">{tr('topics')}</h2>
        <p class="block-note">{tr('topicsLead')}</p>
      </div>
      <ul class="topic-grid">
        {
          groups.map((g, i) => (
            <li>
              <a class="topic-card reveal" href={url(lang, `/topic/${g.id}/`)}>
                <span class="label">( {String(i + 1).padStart(2, '0')} )</span>
                <Illus name={illusOf(g.id)} />
                <span class="topic-title">{SECTIONS[g.id].title[lang]}</span>
                <span class="topic-meta">
                  {articles(lang, g.pages.length)}
                  <span class="round-arrow"><Icon name="arrow" size={16} /></span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {hasPhotos && (
  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <h2 class="h2">{tr('cities')}</h2>
        <p class="block-note">{tr('citiesLead')}</p>
      </div>
    </div>
    <ul class="cities">
      {
        CITY_CARDS.map((c) => (
          <li>
            <a class="city reveal" href={url(lang, `/guide/${c.slug}/`)}>
              <Photo id={c.photo} credit={false} sizes="(min-width: 900px) 30vw, 78vw" />
              {PAGE_VIDEO[c.slug] && (
                <span class="city-video">
                  <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13a.6.6 0 0 0 .9.5l10.4-6.5a.6.6 0 0 0 0-1L8.9 5a.6.6 0 0 0-.9.5Z" fill="currentColor" /></svg>
                  {tr('video')}
                </span>
              )}
              <span class="city-name">{c.title[lang]}</span>
              <span class="round-arrow"><Icon name="arrow" size={16} /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  )}

  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <h2 class="h2">{tr('popular')}</h2>
      </div>
      <ul class="rows">
        {
          popular.map((p) => (
            <li>
              <a href={url(lang, `/guide/${p.slug}/`)}>
                <span class="label">{SECTIONS[p.entry.data.section].title[lang]}</span>
                <strong>{p.entry.data.title}</strong>
                <span class="row-lead">{p.entry.data.description}</span>
                <span class="round-arrow"><Icon name="arrow" size={16} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="block-head">
        <h2 class="h2">{tr('faq')}</h2>
        <a class="pill pill-dark" href={url(lang, '/faq/')}>{tr('faq')}<span class="pill-arrow"><Icon name="arrow" size={16} /></span></a>
      </div>
      <div class="faq-list">
        {
          faqPreview.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <span class="plus" aria-hidden="true" />
              </summary>
              <div class="faq-a">
                <p>{f.a}</p>
                <a class="text-link" href={url(lang, `/guide/${f.slug}/`)}>
                  {bySlug.get(f.slug)?.entry.data.title} <Icon name="arrow" size={16} />
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
