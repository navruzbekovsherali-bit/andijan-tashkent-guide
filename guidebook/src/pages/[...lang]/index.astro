---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Guide from '../../components/Guide.astro';
import { langPaths } from '../../lib/paths';
import { t, url, type Lang } from '../../lib/i18n';
import { getPages, SECTIONS } from '../../lib/content';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const pages = await getPages(lang);
const bySlug = new Map(pages.map((p) => [p.slug, p]));

const popularSlugs = ['arrival-72h', 'first-day-week', 'work-time', 'salary-expat', 'relocation-budget', 'emergency'];
const popular = popularSlugs.map((s) => bySlug.get(s)).filter((p): p is NonNullable<typeof p> => Boolean(p));
const faqPreview = pages.flatMap((p) => p.entry.data.faq.slice(0, 1).map((f) => ({ ...f, slug: p.slug }))).slice(0, 5);
const words = tr('heroTitle').split(' ');
const last = words.pop();
---

<Base lang={lang} title={tr('siteName')} description={tr('heroLead')} path="/" current="home">
  <section class="hero">
    <div class="wrap">
      <h1>{words.join(' ')} <span class="mark">{last}</span></h1>
      <p class="hero-lead">{tr('heroLead')}</p>
      <svg class="hero-art draw" viewBox="0 0 360 260" fill="none" aria-hidden="true">
        <path d="M20 220 C 90 220, 80 120, 160 120 S 250 40, 330 40" stroke="var(--line-2)" stroke-width="6" stroke-linecap="round"></path>
        <path d="M20 240 C 120 240, 140 180, 220 180 S 300 150, 340 110" stroke="var(--line-1)" stroke-width="6" stroke-linecap="round"></path>
        <circle cx="20" cy="220" r="9" fill="var(--paper)" stroke="var(--line-2)" stroke-width="5"></circle>
        <circle cx="160" cy="120" r="9" fill="var(--paper)" stroke="var(--line-2)" stroke-width="5"></circle>
        <circle cx="330" cy="40" r="11" fill="var(--line-2)"></circle>
        <circle cx="220" cy="180" r="9" fill="var(--paper)" stroke="var(--line-1)" stroke-width="5"></circle>
        <circle cx="340" cy="110" r="11" fill="var(--line-1)"></circle>
      </svg>
      <Guide name={tr('guideName')}>
        <p>{tr('guideHello')}</p>
      </Guide>
    </div>
  </section>

  <div class="wrap">
    <h2 class="visually-hidden">{tr('chooseTitle')}</h2>
    <div class="choose">
      <a class="door reveal" href={url(lang, '/local/')} data-choose="local">
        <div>
          <h2 style="view-transition-name: aud-local">{tr('local')}</h2>
          <p>{tr('localLead')}</p>
        </div>
        <span class="go"><Icon name="arrow" /></span>
      </a>
      <a class="door reveal" href={url(lang, '/expat/')} data-choose="expat">
        <div>
          <h2 style="view-transition-name: aud-expat">{tr('expat')}</h2>
          <p>{tr('expatLead')}</p>
        </div>
        <span class="go"><Icon name="arrow" /></span>
      </a>
    </div>

    <h2 class="block-title">{tr('popular')}</h2>
    <ul class="quick">
      {
        popular.map((p) => (
          <li class="reveal">
            <a href={url(lang, `/guide/${p.slug}/`)}>
              <span class="q-ico" style={`--line: var(--line-${SECTIONS[p.entry.data.section].line})`}>
                <Icon name={SECTIONS[p.entry.data.section].icon} />
              </span>
              <span>
                <strong>{p.entry.data.title}</strong>
                <span class="d">{p.entry.data.description}</span>
              </span>
              <Icon name="chevron" />
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="block-title">{tr('faq')}</h2>
    <div class="faq-list">
      {
        faqPreview.map((f) => (
          <details class="faq-item reveal">
            <summary>
              <span>{f.q}</span>
              <Icon name="chevron" />
            </summary>
            <div class="faq-a">
              <p>{f.a}</p>
              <a class="faq-src" href={url(lang, `/guide/${f.slug}/`)}>{bySlug.get(f.slug)?.entry.data.title} →</a>
            </div>
          </details>
        ))
      }
    </div>
    <p style="margin-top: var(--space-4)">
      <a class="btn ghost" href={url(lang, '/faq/')}>{tr('faq')} <Icon name="arrow" size={18} /></a>
    </p>
  </div>
</Base>
