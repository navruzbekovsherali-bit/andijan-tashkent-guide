---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { langPaths } from '../../lib/paths';
import { t, url, type Lang } from '../../lib/i18n';
import { getPages, groupBySection, SECTIONS } from '../../lib/content';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const tr = t(lang);
const groups = groupBySection(await getPages(lang))
  .map((g) => ({ ...g, items: g.pages.flatMap((p) => p.entry.data.faq.map((f) => ({ ...f, p }))) }))
  .filter((g) => g.items.length > 0);
// The questions people ask first, before the rest by topic.
const TOP = ['first-day-week', 'salary-local', 'salary-expat', 'arrival-72h', 'work-time', 'sick-leave', 'emergency'];
const pagesBySlug = new Map(groups.flatMap((g) => g.pages).map((p) => [p.slug, p]));
const top = TOP.flatMap((s) => {
  const p = pagesBySlug.get(s);
  const f = p?.entry.data.faq[0];
  return p && f ? [{ ...f, p }] : [];
});
const forWhom = (aud: string[]) => (aud.length === 2 ? '' : aud[0] === 'local' ? tr('localShort') : tr('expatShort'));
const blocks = [{ id: 'top', title: tr('topQuestions'), items: top }, ...groups.map((g) => ({ id: g.id, title: SECTIONS[g.id].title[lang], items: g.items }))];
---

<Base lang={lang} title={tr('faq')} description={tr('faqLead')} path="/faq/" current="faq" back={url(lang, '/')}>
  <header class="page-head">
    <div class="wrap">
      <h1>{tr('faq')}</h1>
      <p class="lead">{tr('faqLead')}</p>
    </div>
  </header>
  <div class="wrap">
    <label class="search-field faq-filter">
      <span class="visually-hidden">{tr('faqSearch')}</span>
      <Icon name="search" />
      <input type="search" id="faq-filter" placeholder={tr('faqSearch')} autocomplete="off" />
    </label>
    <div class="seg three faq-aud" role="group" aria-label={tr('audienceSwitch')}>
      <button type="button" data-aud="all">{tr('all')}</button>
      <button type="button" data-aud="local">{tr('localShort')}</button>
      <button type="button" data-aud="expat">{tr('expatShort')}</button>
    </div>
    <p class="search-hint" id="faq-empty" hidden>{tr('searchEmpty')}</p>

    {
      blocks.map((g) => (
        <section class:list={['faq-group', { 'faq-top': g.id === 'top' }]}>
          <h2 class="section-title">{g.title}</h2>
          <div class="faq-list">
            {g.items.map((f) => (
              <details class="faq-item" data-aud-list={f.p.entry.data.audience.join(' ')} data-q={`${f.q} ${f.a}`.toLowerCase()}>
                <summary>
                  <span>
                    {f.q}
                    {forWhom(f.p.entry.data.audience) && <span class="q-aud">{forWhom(f.p.entry.data.audience)}</span>}
                  </span>
                  <span class="plus" aria-hidden="true" />
                </summary>
                <div class="faq-a">
                  <p>{f.a}</p>
                  <a class="text-link" href={url(lang, `/guide/${f.p.slug}/`)}>
                    {f.p.entry.data.title} <Icon name="arrow" size={16} />
                  </a>
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<script>
  import { stems } from '../../lib/client';
  const input = document.getElementById('faq-filter') as HTMLInputElement | null;
  // Text matches are marked separately from the audience filter (which uses [hidden]) so the two combine.
  const filter = () => {
    const terms = stems(input?.value || '');
    let shown = 0;
    document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((d) => {
      const hay = (d.dataset.q || '').replace(/ё/g, 'е');
      const ok = terms.every((t) => hay.includes(t));
      d.toggleAttribute('data-miss', !ok);
      const visible = ok && !d.hidden;
      if (visible) shown++;
      d.open = visible && terms.length > 0 && shown <= 3;
    });
    document.querySelectorAll<HTMLElement>('.faq-group').forEach((g) => {
      g.hidden = !g.querySelector('.faq-item:not([hidden]):not([data-miss])');
    });
    document.getElementById('faq-empty')!.hidden = shown > 0;
  };
  input?.addEventListener('input', filter);
  document.addEventListener('gb:audience', filter);
  filter();
</script>
