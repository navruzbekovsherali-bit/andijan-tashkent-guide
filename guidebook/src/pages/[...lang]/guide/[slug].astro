---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Guide from '../../../components/Guide.astro';
import Illus from '../../../components/Illus.astro';
import Photo from '../../../components/Photo.astro';
import Sos from '../../../components/Sos.astro';
import { articles, LANGS, DEFAULT_LANG, t, url, type Lang } from '../../../lib/i18n';
import { getPages, forAudience, readingMinutes, SECTIONS, SECTION_ORDER, illusOf, PAGE_PHOTO, PAGE_VIDEO, CHECKLISTS } from '../../../lib/content';

export async function getStaticPaths() {
  const out = [];
  for (const lang of LANGS) {
    const pages = await getPages(lang);
    for (const p of pages) {
      out.push({ params: { lang: lang === DEFAULT_LANG ? undefined : lang, slug: p.slug }, props: { lang, slug: p.slug } });
    }
  }
  return out;
}

const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const tr = t(lang);
const pages = await getPages(lang);
const page = pages.find((p) => p.slug === slug)!;
const { entry, fallback } = page;
const data = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const section = SECTIONS[data.section];
const audience = data.audience.length === 1 ? data.audience[0] : 'both';

// Prev/next along the reader's own line (expat line for shared pages unless they came from local).
const line = forAudience(pages, audience === 'local' ? 'local' : 'expat');
const i = line.findIndex((p) => p.slug === slug);
const prev = i > 0 ? line[i - 1] : undefined;
const next = i >= 0 && i < line.length - 1 ? line[i + 1] : undefined;

const fmtDate = (d: Date) =>
  d.toLocaleDateString(lang === 'en' ? 'en-GB' : lang === 'uz' ? 'uz-UZ' : 'ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const hubAud = audience === 'local' ? 'local' : 'expat';
const topicNo = String(SECTION_ORDER.indexOf(data.section) + 1).padStart(2, '0');
const photoId = slug === 'emergency' ? undefined : PAGE_PHOTO[slug];
---

<Base lang={lang} title={data.title} description={data.description} path={`/guide/${slug}/`} audience={audience} back={url(lang, `/topic/${data.section}/`)}>
  <div class="read-progress" aria-hidden="true"></div>
  {
    photoId && (
      <div class="city-hero">
        <Photo id={photoId} class="city-photo" eager sizes="(min-width: 900px) 1320px, 100vw" video={PAGE_VIDEO[slug]} videoLabel={tr('watchVideo')} lang={lang} />
      </div>
    )
  }
  <header class:list={['page-head', { 'after-photo': photoId }]}>
    <div class="wrap head-grid">
      <div>
        <p class="label"><a href={url(lang, `/topic/${data.section}/`)}>( {topicNo} ) {section.title[lang]}</a></p>
        <h1>{data.title}</h1>
        <p class="lead">{data.description}</p>
        <div class="meta-row">
          <span class="chip">
            {data.audience.length === 2 ? tr('both') : data.audience[0] === 'local' ? tr('localShort') : tr('expatShort')}
          </span>
          <span class="chip"><Icon name="clock" size={14} />{readingMinutes(entry.body)} {tr('minutes')}</span>
          {data.checked && (
            <span class="chip ok">
              <Icon name="check" size={14} />
              {tr('checked')} {fmtDate(data.checked)}
            </span>
          )}
        </div>
      </div>
      {slug === 'emergency' ? <Sos lang={lang} /> : !photoId && <Illus name={illusOf(data.section, slug)} />}
    </div>
  </header>

  <div class="wrap">
    <div class="article-layout">
      <article data-checklist={CHECKLISTS.includes(slug) ? slug : undefined}>
        {fallback && <p class="note">{tr('translationSoon')}</p>}
        {data.tldr.length > 0 && (
          <section class="summary" aria-labelledby="tldr">
            <h2 id="tldr">{tr('short')}</h2>
            <ul>
              {data.tldr.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </section>
        )}

        <div class="prose">
          <Content />
        </div>

        {data.faq.length > 0 && (
          <section>
            <h2 class="section-title">{tr('faq')}</h2>
            <div class="faq-list">
              {data.faq.map((f) => (
                <details class="faq-item">
                  <summary>
                    <span>{f.q}</span>
                    <span class="plus" aria-hidden="true" />
                  </summary>
                  <div class="faq-a">
                    <p>{f.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        {data.needsConfirmation && (
          <p class="note-quiet">
            <Icon name="info" size={18} />
            <span>{tr('confirm')}</span>
          </p>
        )}

        {data.sources.length > 0 && (
          <footer class="sources">
            <h2>{tr('sources')}</h2>
            <ul>
              {data.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
                </li>
              ))}
            </ul>
          </footer>
        )}

        <nav class="pager" aria-label={`${tr('prev')} / ${tr('next')}`}>
          {prev ? (
            <a class="prev" href={url(lang, `/guide/${prev.slug}/`)}>
              <span class="dir"><Icon name="back" size={14} />{tr('prevArticle')}</span>
              <strong>{prev.entry.data.title}</strong>
            </a>
          ) : (
            <a class="prev" href={url(lang, `/topic/${data.section}/`)}>
              <span class="dir"><Icon name="back" size={14} />{tr('back')}</span>
              <strong>{section.title[lang]}</strong>
            </a>
          )}
          {next && (
            <a class="next" href={url(lang, `/guide/${next.slug}/`)}>
              <span class="dir">{tr('nextArticle')}<Icon name="arrow" size={14} /></span>
              <strong>{next.entry.data.title}</strong>
            </a>
          )}
        </nav>
      </article>

      {toc.length > 1 && (
        <aside class="toc" aria-label={tr('onThisPage')}>
          <p class="label">{tr('onThisPage')}</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </div>
</Base>
