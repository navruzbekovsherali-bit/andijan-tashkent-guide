---
import '../styles/global.css';
import '../styles/illus-a.css';
import '../styles/illus-b.css';
import Icon from '../components/Icon.astro';
import BrandMark from '../components/BrandMark.astro';
import GuideFace from '../components/GuideFace.astro';
import { LANGS, LANG_LABEL, t, url, type Lang } from '../lib/i18n';
import { getPages, groupBySection, SECTIONS } from '../lib/content';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path without language prefix, used for the language switcher. */
  path: string;
  /** Current audience context, if the page belongs to one. */
  audience?: 'local' | 'expat' | 'both';
  current?: 'home' | 'local' | 'expat' | 'faq' | 'topic' | 'page';
  /** Where "Назад" leads when there is no history to go back to. Absent on the home page. */
  back?: string;
  /** The page opens on the dark brand field (home): the top bar starts light-on-dark. */
  dark?: boolean;
}

const { lang, title, description, path, audience = 'both', current = 'page', back, dark = false } = Astro.props;
const tr = t(lang);
const pages = await getPages(lang);
const groups = groupBySection(pages);
const pageTitle = current === 'home' ? tr('siteName') : `${title} — ${tr('siteName')}`;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} data-audience={audience} class:list={[{ 'starts-dark': dark }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content={dark ? '#0b1f1d' : '#f5f4f0'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(url(l, path), Astro.site)} />)}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
    </script>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var au = localStorage.getItem('gb-audience');
          if (au && d.dataset.audience === 'both') d.dataset.pref = au;
        } catch (e) {}
        // Arriving behind the brand curtain: start covered, the client lifts it.
        function takeCover() {
          try {
            if (!sessionStorage.getItem('gb-cover')) return;
            sessionStorage.removeItem('gb-cover');
            d.classList.add('is-covered');
          } catch (e) {}
        }
        if (document.prerendering) document.addEventListener('prerenderingchange', takeCover, { once: true });
        else takeCover();
        window.addEventListener('pagereveal', function (e) {
          if (!e.viewTransition || !d.classList.contains('is-covered')) return;
          e.viewTransition.ready.catch(function () {});
          e.viewTransition.skipTransition();
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{tr('skip')}</a>

    <header class="topbar">
      <div class="topbar-in glass">
        {
          back && (
            <a class="tb-back" href={back} data-back aria-label={tr('back')}>
              <Icon name="back" size={20} />
              <span>{tr('back')}</span>
            </a>
          )
        }
        <a class="brand" href={url(lang, '/')} aria-label="Hamkor Bank — главная">
          <BrandMark />
          <span class="brand-name">Hamkor Bank</span>
        </a>
        <nav class="tb-nav" aria-label={tr('menu')}>
          <a href={url(lang, '/#topics')}>{tr('topics')}</a>
          <a href={url(lang, '/local/')} data-nav="local">{tr('localShort')}</a>
          <a href={url(lang, '/expat/')} data-nav="expat">{tr('expatShort')}</a>
          <a href={url(lang, '/faq/')} data-nav="faq">{tr('faq')}</a>
        </nav>
        <button class="tb-icon" type="button" data-sheet="search" aria-label={tr('search')}><Icon name="search" /></button>
        <button class="tb-icon tb-menu" type="button" data-sheet="drawer" aria-label={tr('menu')}><Icon name="menu" /></button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-in">
        <a class="footer-brand" href={url(lang, '/')}>
          <BrandMark />
          <span>Hamkor Bank<small>{tr('bankGuide')}</small></span>
        </a>
        <nav class="footer-links">
          <a href={url(lang, '/#topics')}>{tr('topics')}</a>
          <a href={url(lang, '/faq/')}>{tr('faq')}</a>
          <a href={url(lang, '/guide/contacts/')}>{tr('contacts')}</a>
          <a href={url(lang, '/guide/emergency/')}>{tr('emergency')}</a>
        </nav>
      </div>
    </footer>

    <!-- Phone dock: back first, then home, search, menu -->
    <nav class="dock glass" aria-label={tr('menu')}>
      <span class="dock-lens" aria-hidden="true"></span>
      {
        back ? (
          <a href={back} data-back>
            <Icon name="back" />
            <span>{tr('back')}</span>
          </a>
        ) : (
          <a href={url(lang, '/faq/')} data-nav="faq">
            <Icon name="question" />
            <span>{tr('faqShort')}</span>
          </a>
        )
      }
      <a href={url(lang, '/')} data-nav="home"><Icon name="home" /><span>{tr('home')}</span></a>
      <button type="button" data-sheet="search"><Icon name="search" /><span>{tr('search')}</span></button>
      <button type="button" data-sheet="drawer"><Icon name="menu" /><span>{tr('menu')}</span></button>
    </nav>

    <!-- Drawer -->
    <div class="sheet drawer-sheet" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
      <div class="sheet-scrim" data-close></div>
      <div class="sheet-panel">
        <div class="sheet-grip" aria-hidden="true"></div>
        <div class="sheet-head">
          <h2 id="drawer-title">{tr('allSections')}</h2>
          <button class="tb-icon" type="button" data-close aria-label={tr('close')}><Icon name="close" /></button>
        </div>
        <div class="sheet-body">
          <div class="seg" role="group" aria-label={tr('audienceSwitch')}>
            <button type="button" data-aud="local">{tr('localShort')}</button>
            <button type="button" data-aud="expat">{tr('expatShort')}</button>
          </div>
          {
            groups.map((g, i) => (
              <section class="nav-group">
                <h3 class="nav-group-title">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <a href={url(lang, `/topic/${g.id}/`)}>{SECTIONS[g.id].title[lang]}</a>
                </h3>
                <ul class="nav-list">
                  {g.pages.map((p) => (
                    <li data-aud-list={p.entry.data.audience.join(' ')}>
                      <a href={url(lang, `/guide/${p.slug}/`)}>{p.entry.data.title}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
          <div class="drawer-foot">
            <a class="pill pill-dark" href={url(lang, '/faq/')}>{tr('faq')}<span class="pill-arrow"><Icon name="arrow" size={16} /></span></a>
            <div>
              <p class="label">Язык · Language · Til</p>
              <div class="seg three">
                {LANGS.map((l) => <a href={url(l, path)} aria-current={l === lang ? 'true' : undefined} hreflang={l}>{LANG_LABEL[l]}</a>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Search -->
    <div class="sheet search-sheet" id="search" role="dialog" aria-modal="true" aria-labelledby="search-title" data-lang={lang}>
      <div class="sheet-scrim" data-close></div>
      <div class="sheet-panel">
        <div class="sheet-grip" aria-hidden="true"></div>
        <div class="sheet-head">
          <h2 id="search-title">{tr('search')}</h2>
          <button class="tb-icon" type="button" data-close aria-label={tr('close')}><Icon name="close" /></button>
        </div>
        <div class="sheet-body">
          <label class="search-field">
            <span class="visually-hidden">{tr('search')}</span>
            <Icon name="search" />
            <input type="search" id="search-input" placeholder={tr('searchPlaceholder')} autocomplete="off" enterkeyhint="search" />
          </label>
          <p class="search-hint" id="search-hint" data-empty={tr('searchEmpty')} data-hint={tr('searchHint')}>{tr('searchHint')}</p>
          <ul class="results" id="search-results" aria-live="polite"></ul>
        </div>
      </div>
    </div>

    <template id="guide-face-tpl"><GuideFace /></template>

    <!-- Page change: the bank's dark curtain with its mark -->
    <div class="curtain" aria-hidden="true"><div class="curtain-mark"><BrandMark /></div></div>

    <script>
      import { initSite } from '../lib/client';
      initSite();
    </script>
  </body>
</html>
